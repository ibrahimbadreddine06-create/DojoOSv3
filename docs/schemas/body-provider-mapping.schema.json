{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dojo.example/schemas/body-provider-mapping.schema.json",
  "title": "Body Provider Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mapping_id",
    "provider",
    "connection_route",
    "provider_object",
    "provider_field",
    "provider_meaning",
    "record_shape",
    "canonical_type",
    "provenance_class",
    "confidence",
    "evidence",
    "verified_at"
  ],
  "properties": {
    "mapping_id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "connection_route": {
      "enum": [
        "native_health_store",
        "direct_cloud_api",
        "aggregator",
        "file_import",
        "manual"
      ]
    },
    "provider_object": {
      "type": "string",
      "minLength": 1
    },
    "provider_field": {
      "type": "string",
      "minLength": 1
    },
    "provider_meaning": {
      "type": "string",
      "minLength": 1
    },
    "source_unit": {
      "type": ["string", "null"]
    },
    "record_shape": {
      "enum": [
        "measurement",
        "sample_series",
        "interval",
        "session",
        "event",
        "daily_summary",
        "goal",
        "profile_fact",
        "clinical_record",
        "provider_insight",
        "extension"
      ]
    },
    "resolution": {
      "type": ["string", "null"]
    },
    "availability_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permission": {
      "type": ["string", "null"]
    },
    "provenance_class": {
      "enum": [
        "measured",
        "manual",
        "active",
        "passive",
        "provider_derived",
        "clinical",
        "metadata"
      ]
    },
    "source_metadata_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "historical_access": {
      "type": ["string", "null"]
    },
    "writable": {
      "type": "boolean"
    },
    "canonical_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+(?:@[1-9][0-9]*)?$"
    },
    "canonical_unit": {
      "type": ["string", "null"]
    },
    "conversion": {
      "type": ["string", "null"]
    },
    "confidence": {
      "enum": ["verified", "partial", "inferred", "unknown"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "level", "claim"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "level": {
            "enum": [1, 2, 3, 4]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
