{
  "schema_version": "1.0.0",
  "updated_at": "2026-07-25",
  "evidence_register": "docs/body-scientific-validation-matrix.md",
  "dispositions": {
    "body_calculated": "Body may calculate under the named versioned method.",
    "observation": "Body may normalize, aggregate and display without adding a stronger interpretation.",
    "provider_result": "Display the provider-owned value with namespace, source and limitations.",
    "research_only": "Do not expose as a production result before validation.",
    "rejected": "The proposed result or claim must not ship."
  },
  "metrics": [
    {
      "id": "activity.steps",
      "disposition": "observation",
      "confidence": "device_dependent",
      "required_labels": ["recorded", "source"],
      "forbidden_claims": ["true_step_count", "universal_10000_step_requirement"]
    },
    {
      "id": "activity.active_minutes",
      "disposition": "observation",
      "confidence": "moderate",
      "required_labels": ["classification_method", "coverage"],
      "forbidden_claims": ["all_provider_minutes_are_equivalent"]
    },
    {
      "id": "activity.session_duration",
      "disposition": "body_calculated",
      "confidence": "high_when_interval_valid",
      "formula": "end_timestamp - start_timestamp",
      "unit": "s",
      "required_labels": ["elapsed_or_active_or_moving"],
      "forbidden_claims": ["duration_is_intensity", "moving_time_is_elapsed_time"]
    },
    {
      "id": "activity.sedentary_time",
      "disposition": "observation",
      "confidence": "low_to_moderate",
      "required_labels": ["device_classified", "valid_wear"],
      "forbidden_claims": ["nonwear_is_sedentary"]
    },
    {
      "id": "energy.active_expenditure",
      "disposition": "provider_result",
      "confidence": "low_individual_absolute",
      "required_labels": ["estimated", "provider", "active_or_total"],
      "forbidden_claims": ["exact_energy_expenditure", "exact_energy_balance"]
    },
    {
      "id": "cardio.heart_rate",
      "disposition": "observation",
      "confidence": "context_dependent",
      "required_labels": ["sensor_source", "coverage"],
      "forbidden_claims": ["medical_rhythm_interpretation_from_generic_ppg"]
    },
    {
      "id": "cardio.heart_rate_zones",
      "disposition": "body_calculated",
      "confidence": "model_dependent",
      "required_labels": ["zone_model", "threshold_version"],
      "forbidden_claims": ["universal_five_zone_truth"]
    },
    {
      "id": "cardio.vo2_max",
      "disposition": "provider_result",
      "confidence": "moderate_to_low_individual_estimate",
      "required_labels": ["estimated_or_measured", "method", "provider"],
      "forbidden_claims": ["wearable_estimate_is_lab_measurement"]
    },
    {
      "id": "load.session_rpe",
      "disposition": "body_calculated",
      "confidence": "moderate",
      "formula": "duration_minutes * rpe_cr10",
      "unit": "AU",
      "required_labels": ["perceived", "scale"],
      "forbidden_claims": ["mechanical_load", "injury_risk", "calories"]
    },
    {
      "id": "load.trimp",
      "disposition": "research_only",
      "confidence": "variant_dependent",
      "required_labels": ["formula_variant"],
      "forbidden_claims": ["generic_trimp_without_formula"]
    },
    {
      "id": "load.acute_chronic_trends",
      "disposition": "body_calculated",
      "confidence": "moderate_descriptive",
      "required_labels": ["short_window", "long_window", "load_method"],
      "forbidden_claims": ["injury_probability", "safe_zone"]
    },
    {
      "id": "load.acwr_injury_prediction",
      "disposition": "rejected",
      "confidence": "unsupported_causal_use",
      "forbidden_claims": ["injury_prediction", "injury_prevention_recommendation"]
    },
    {
      "id": "load.muscular_universal_score",
      "disposition": "research_only",
      "confidence": "insufficient",
      "forbidden_claims": ["heart_rate_equals_muscular_load"]
    },
    {
      "id": "recovery.resting_heart_rate",
      "disposition": "observation",
      "confidence": "moderate_to_high_consistent_protocol",
      "required_labels": ["method", "personal_baseline"],
      "forbidden_claims": ["cause_attribution"]
    },
    {
      "id": "recovery.hrv_rmssd",
      "disposition": "observation",
      "confidence": "moderate_consistent_protocol",
      "required_labels": ["hrv_metric", "aggregation", "sensor", "baseline"],
      "forbidden_claims": ["low_hrv_equals_stress_or_illness", "cross_metric_equivalence"]
    },
    {
      "id": "recovery.readiness_score",
      "disposition": "provider_result",
      "confidence": "provider_model_dependent",
      "required_labels": ["provider", "contributors_if_available"],
      "forbidden_claims": ["cross_provider_score_equivalence", "reverse_engineered_formula"]
    },
    {
      "id": "sleep.total_sleep_time",
      "disposition": "observation",
      "confidence": "moderate_longitudinal",
      "required_labels": ["wearable_estimated", "source"],
      "forbidden_claims": ["psg_equivalence"]
    },
    {
      "id": "sleep.efficiency",
      "disposition": "body_calculated",
      "confidence": "source_dependent",
      "formula": "total_sleep_minutes / time_in_bed_minutes * 100",
      "unit": "percent",
      "required_labels": ["estimated_if_wearable"],
      "forbidden_claims": ["clinical_interpretation_without_validation"]
    },
    {
      "id": "sleep.midpoint",
      "disposition": "body_calculated",
      "confidence": "high_when_episode_bounds_valid",
      "formula": "start_timestamp + (end_timestamp - start_timestamp) / 2",
      "required_labels": ["local_timezone", "episode_source"],
      "forbidden_claims": ["chronotype_diagnosis"]
    },
    {
      "id": "sleep.regularity",
      "disposition": "body_calculated",
      "confidence": "moderate_descriptive",
      "required_labels": ["window", "valid_days"],
      "forbidden_claims": ["universal_optimal_variability_threshold"]
    },
    {
      "id": "sleep.stages",
      "disposition": "provider_result",
      "confidence": "low_to_moderate",
      "required_labels": ["estimated", "provider"],
      "forbidden_claims": ["psg_equivalence", "cross_provider_correction"]
    },
    {
      "id": "sleep.debt_or_need",
      "disposition": "provider_result",
      "confidence": "provider_model_dependent",
      "required_labels": ["provider"],
      "forbidden_claims": ["universal_cumulative_subtraction"]
    },
    {
      "id": "sleep.body_score",
      "disposition": "research_only",
      "confidence": "unvalidated",
      "forbidden_claims": ["production_sleep_score_without_prospective_validation"]
    },
    {
      "id": "blood_pressure.cuff_reading",
      "disposition": "observation",
      "confidence": "high_validated_device_and_protocol",
      "required_labels": ["device", "measurement_context", "protocol"],
      "forbidden_claims": ["diagnosis_from_single_reading", "office_home_threshold_equivalence"]
    },
    {
      "id": "blood_pressure.cuffless_estimate",
      "disposition": "provider_result",
      "confidence": "device_dependent",
      "required_labels": ["estimated", "provider", "calibration"],
      "forbidden_claims": ["cuff_replacement", "hypertension_diagnosis"]
    },
    {
      "id": "oxygen.spo2",
      "disposition": "provider_result",
