      "required_labels": ["provider", "cohort_or_method"],
      "forbidden_claims": ["absolute_cardiovascular_risk", "cross_provider_age_comparison"]
    },
    {
      "id": "body.weight",
      "disposition": "observation",
      "confidence": "high_valid_scale_and_attribution",
      "required_labels": ["source", "user_attribution"],
      "forbidden_claims": ["short_change_equals_fat_or_muscle_change"]
    },
    {
      "id": "body.bmi",
      "disposition": "body_calculated",
      "confidence": "high_formula_limited_screening",
      "formula": "weight_kg / height_m^2",
      "unit": "kg/m2",
      "required_labels": ["screening", "population_reference"],
      "forbidden_claims": ["diagnosis", "body_fat_equivalence", "adult_thresholds_for_children"]
    },
    {
      "id": "body.bia_composition",
      "disposition": "provider_result",
      "confidence": "component_and_device_dependent",
      "required_labels": ["estimated", "device", "protocol"],
      "forbidden_claims": ["dxa_equivalence", "small_change_below_repeatability"]
    },
    {
      "id": "nutrition.logged_intake",
      "disposition": "observation",
      "confidence": "logging_and_database_dependent",
      "required_labels": ["logged", "database_version", "coverage"],
      "forbidden_claims": ["actual_complete_intake_when_incomplete"]
    },
    {
      "id": "nutrition.exact_energy_balance",
      "disposition": "rejected",
      "confidence": "insufficient_individual_precision",
      "forbidden_claims": ["exact_daily_surplus_or_deficit", "single_day_tissue_change"]
